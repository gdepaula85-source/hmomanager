PORT=3000
NODE_ENV=development

# Supabase (browser uses anon key via /config.js)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: required for JWT verification on POST /api/ai/messages and POST /api/email/send
# (Dashboard → Project Settings → API → service_role — never commit or expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only: Anthropic (never expose to the browser)
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: comma-separated origins for production CORS (omit or * for dev)
# CORS_ORIGIN=https://yourdomain.com

# Optional: AI route rate limit per IP per 15 minutes (default 80)
# AI_RATE_LIMIT_MAX=80

# Server-only: transactional email (Resend). Used by POST /api/email/send (tenant reminders, reports).
# Verify domain landlordapp.io in Resend (DNS). No separate "Add sender" in Resend — any @landlordapp.io works.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional: From header (examples: noreply@, billing@, support@ on verified domain)
# MAIL_FROM=Landlord App <noreply@landlordapp.io>
# Optional: email rate limit per IP per 15 minutes (default 60)
# EMAIL_RATE_LIMIT_MAX=60

# Server-only: Stripe billing/subscriptions
# Create products/prices in Stripe and map each plan to a recurring price ID.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx
# Public base URL used for Stripe success/cancel and billing portal return
# APP_BASE_URL=http://localhost:3000

WORKER_URL=https://calm-cell-1923.g-depaula85.workers.dev/index.html
